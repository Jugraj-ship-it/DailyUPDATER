# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this across environments, and never commit the real value.
AUTH_SECRET=""

# From resend.com's dashboard (free tier). Powers the "forgot password" email.
RESEND_API_KEY=""

# Optional - defaults to Resend's shared "onboarding@resend.dev" sender,
# which works without verifying your own domain. Set this once you've
# verified a domain in Resend and want mail to come from your own address.
EMAIL_FROM=""
