# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database - contains real password hashes and journal content, never commit
# (SQLite path resolution differs between the Prisma CLI and the Next.js runtime,
# so the file can end up in either location depending on how it's run)
/prisma/*.db
/prisma/*.db-journal
/*.db
/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
